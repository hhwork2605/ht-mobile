@model ProductCardDto

<a href="/@Model.VariantSlug"
   class="group flex h-full flex-col items-center gap-2 rounded-card border border-transparent bg-white p-[18px] pt-5 text-center transition duration-200 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(0,0,0,.10)]">
    <div class="relative flex aspect-square w-full items-center justify-center overflow-hidden rounded-2xl bg-surface2">
        @if (Model.IsNew)
        {
            <span class="absolute left-3 top-3 rounded-full bg-white px-2.5 py-1 text-[11.5px] font-semibold tracking-wide text-accent shadow-sm">Mới</span>
        }
        @if (Model.DiscountPercent > 0)
        {
            <span class="absolute right-3 top-3 rounded-full bg-sale px-2.5 py-1 text-[11.5px] font-semibold tracking-wide text-white">-@Model.DiscountPercent%</span>
        }
        <img src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "/images/placeholder.svg" : Model.ThumbnailUrl)"
             alt="@Model.Name" class="h-full w-full object-contain p-6" loading="lazy" />
    </div>

    <div class="mt-1 text-base font-semibold leading-snug text-ink group-hover:text-accent">@Model.Name</div>
    @if (!string.IsNullOrWhiteSpace(Model.Tagline))
    {
        <div class="text-[13px] leading-snug text-ink2">@Model.Tagline</div>
    }

    <div class="mt-1.5 flex items-baseline justify-center gap-2">
        <span class="text-[17px] font-semibold text-ink">@Model.FinalPrice.ToString("#,##0")đ</span>
        @if (Model.CompareAtPrice is > 0 && Model.CompareAtPrice > Model.FinalPrice)
        {
            <span class="text-[13px] text-ink2 line-through">@Model.CompareAtPrice.Value.ToString("#,##0")đ</span>
        }
    </div>

    <span class="mt-2.5 rounded-full bg-accent px-[22px] py-[9px] text-sm font-semibold text-white transition group-hover:bg-accent-press">Mua</span>
</a>
