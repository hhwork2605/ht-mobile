@model EffectivePrice

<div class="flex items-baseline gap-2">
    <span class="text-2xl font-bold text-red-600">@Model.FinalPrice.ToString("#,##0")₫</span>
    @if (Model.CompareAtPrice is > 0 && Model.CompareAtPrice > Model.FinalPrice)
    {
        <span class="text-sm text-gray-400 line-through">@Model.CompareAtPrice.Value.ToString("#,##0")₫</span>
    }
    @if (Model.DiscountPercent > 0)
    {
        <span class="rounded bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-600">-@Model.DiscountPercent%</span>
    }
</div>
@if (!string.IsNullOrEmpty(Model.AppliedPromotionName))
{
    <p class="mt-1 text-xs text-green-600">@Model.AppliedPromotionName</p>
}
