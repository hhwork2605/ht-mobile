@model EffectivePrice

<div class="flex items-baseline gap-2.5 flex-wrap">
    <span class="text-[30px] font-extrabold text-sale">@Model.FinalPrice.ToString("#,##0")₫</span>
    @if (Model.CompareAtPrice is > 0 && Model.CompareAtPrice > Model.FinalPrice)
    {
        <span class="text-[16px] text-ink2 line-through">@Model.CompareAtPrice.Value.ToString("#,##0")₫</span>
    }
    @if (Model.DiscountPercent > 0)
    {
        <span class="rounded-md bg-sale px-2 py-0.5 text-[13px] font-bold text-white">-@Model.DiscountPercent%</span>
    }
</div>
@if (!string.IsNullOrEmpty(Model.AppliedPromotionName))
{
    <p class="mt-1 text-xs text-[color:var(--success)]">@Model.AppliedPromotionName</p>
}
