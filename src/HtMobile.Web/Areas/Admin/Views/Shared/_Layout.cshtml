@inject HtMobile.Application.Common.Interfaces.ICurrentUser CurrentUser
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Token antiforgery cho POST của htmx (đổi trạng thái/thêm biến thể…). Header khớp AddAntiforgery ở Program.cs.
    var xsrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var path = Context.Request.Path.Value ?? "/admin";
    string nav(string href) => path.Equals(href, StringComparison.OrdinalIgnoreCase) || (href != "/admin" && path.StartsWith(href, StringComparison.OrdinalIgnoreCase))
        ? "active"
        : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="xsrf-token" content="@xsrfToken" />
    <title>@ViewData["Title"] · HtMobile Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.5.2/css/all.min.css" />
    <style>
        :root { --hm-accent:#0066CC; --hm-accent-press:#004e9e; }
        body { background:#f5f5f7; }
        .btn-primary { --bs-btn-bg:var(--hm-accent); --bs-btn-border-color:var(--hm-accent); --bs-btn-hover-bg:var(--hm-accent-press); --bs-btn-hover-border-color:var(--hm-accent-press); --bs-btn-active-bg:var(--hm-accent-press); --bs-btn-active-border-color:var(--hm-accent-press); }
        .btn-outline-primary { --bs-btn-color:var(--hm-accent); --bs-btn-border-color:var(--hm-accent); --bs-btn-hover-bg:var(--hm-accent); --bs-btn-hover-border-color:var(--hm-accent); --bs-btn-active-bg:var(--hm-accent); }
        .text-accent { color:var(--hm-accent) !important; }
        a { text-decoration:none; }
        .hm-sidebar { width:244px; min-height:100vh; }
        .hm-sidebar .nav-link { color:#495057; border-radius:10px; padding:.6rem .75rem; font-size:13.5px; font-weight:500; display:flex; align-items:center; gap:.65rem; }
        .hm-sidebar .nav-link:hover { background:#f1f3f5; color:#212529; }
        .hm-sidebar .nav-link.active { background:rgba(0,102,204,.1); color:var(--hm-accent); }
        .hm-sidebar .nav-link.disabled { color:#adb5bd; cursor:not-allowed; }
        .hm-sidebar .nav-link i { width:1rem; text-align:center; }
    </style>
</head>
<body>
    <div class="d-flex">
        <aside class="hm-sidebar bg-white border-end d-flex flex-column flex-shrink-0">
            <a href="/admin" class="d-flex align-items-center gap-2 px-4 fw-bold text-dark border-bottom" style="height:60px;font-size:1.1rem;">
                <i class="fa-brands fa-apple"></i>HtMobile <span class="text-secondary fw-medium">Admin</span>
            </a>
            <nav class="nav flex-column p-3 gap-1 flex-grow-1">
                <a href="/admin" class="nav-link @nav("/admin")"><i class="fa-solid fa-table-columns"></i>Bảng điều khiển</a>
                <a href="/admin/orders" class="nav-link @nav("/admin/orders")"><i class="fa-solid fa-bag-shopping"></i>Đơn hàng</a>
                <a href="/admin/products" class="nav-link @nav("/admin/products")"><i class="fa-solid fa-box"></i>Sản phẩm</a>
                @foreach (var (label, icon) in new[] { ("Khuyến mãi", "fa-bullhorn"), ("Người dùng", "fa-users"), ("Nội dung (CMS)", "fa-file-lines"), ("Báo cáo", "fa-chart-line") })
                {
                    <span class="nav-link disabled" title="Sắp có"><i class="fa-solid @icon"></i>@label</span>
                }
            </nav>
            <a href="/" class="border-top px-4 py-3 small text-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Về cửa hàng</a>
        </aside>

        <div class="flex-grow-1 min-w-0 d-flex flex-column">
            <header class="d-flex align-items-center justify-content-between bg-white border-bottom px-4" style="height:60px;">
                <h1 class="h6 fw-bold mb-0">@ViewData["Title"]</h1>
                <div class="d-flex align-items-center gap-3 small">
                    <span class="text-secondary">@(User.Identity?.Name ?? "Admin")</span>
                    <form method="post" action="/logout" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm fw-semibold">Đăng xuất</button>
                    </form>
                </div>
            </header>
            <main class="flex-grow-1 p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/htmx.org@2.0.3"></script>
    <script>
        // Gắn token antiforgery vào mọi request htmx (đổi trạng thái/thêm biến thể…).
        document.body.addEventListener('htmx:configRequest', function (e) {
            var m = document.querySelector('meta[name="xsrf-token"]');
            if (m) e.detail.headers['RequestVerificationToken'] = m.getAttribute('content');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
