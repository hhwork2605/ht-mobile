@model AdminOrderListDto
@{
    ViewData["Title"] = "Đơn hàng";
    var statuses = new[] { OrderStatus.Pending, OrderStatus.Confirmed, OrderStatus.Processing, OrderStatus.Shipped, OrderStatus.Delivered, OrderStatus.Cancelled, OrderStatus.Refunded };
    string tabCls(bool active) => active ? "border-accent text-ink" : "border-transparent text-ink2 hover:text-ink";
}

<div class="rounded-card border border-line bg-white">
    @* Tab lọc theo trạng thái *@
    <div class="flex flex-wrap items-center gap-1 border-b border-line px-4 pt-3">
        <a href="/admin/orders" class="flex items-center gap-2 border-b-2 px-3.5 pb-3 pt-1.5 text-[13px] font-semibold @tabCls(Model.Filter == null)">
            Tất cả <span class="rounded-full bg-surface2 px-1.5 text-[11px] font-bold">@Model.TotalCount</span>
        </a>
        @foreach (var st in statuses)
        {
            var info = OrderStatusInfo.Describe(st);
            var count = Model.Counts.TryGetValue(st, out var c) ? c : 0;
            <a href="/admin/orders?status=@st" class="flex items-center gap-2 border-b-2 px-3.5 pb-3 pt-1.5 text-[13px] font-semibold @tabCls(Model.Filter == st)">
                @info.Label <span class="rounded-full bg-surface2 px-1.5 text-[11px] font-bold">@count</span>
            </a>
        }
    </div>

    @if (Model.Orders.Count == 0)
    {
        <p class="p-8 text-center text-sm text-ink2">Không có đơn hàng nào.</p>
    }
    else
    {
        <table class="w-full border-collapse">
            <thead>
                <tr class="bg-surface2 text-left text-[11px] font-bold uppercase tracking-wide text-ink2">
                    <th class="px-5 py-2.5">Mã đơn</th>
                    <th class="px-2 py-2.5">Nhận hàng</th>
                    <th class="px-2 py-2.5">Sản phẩm</th>
                    <th class="px-2 py-2.5 text-right">Tổng tiền</th>
                    <th class="px-2 py-2.5 text-center">Thanh toán</th>
                    <th class="px-2 py-2.5 text-center">Trạng thái</th>
                    <th class="px-2 py-2.5">Ngày</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders)
                {
                    var info = OrderStatusInfo.Describe(o.Status);
                    <tr class="border-t border-line hover:bg-surface2">
                        <td class="px-5 py-3"><a href="/admin/orders/@o.Id" class="font-mono text-[12.5px] font-bold text-accent hover:underline">#@o.Code</a></td>
                        <td class="px-2 py-3 text-[12.5px] text-ink">@o.Recipient</td>
                        <td class="px-2 py-3 text-[12.5px] text-ink2">@o.ItemsSummary</td>
                        <td class="px-2 py-3 text-right text-[13px] font-bold text-ink">@o.Total.ToString("#,##0")₫</td>
                        <td class="px-2 py-3 text-center text-[12px] text-ink2">@o.PaymentMethod</td>
                        <td class="px-2 py-3 text-center"><span class="rounded-full px-2.5 py-1 text-[11.5px] font-semibold @(info.IsCancelled ? "bg-red-50 text-red-600" : "bg-surface2 text-accent")">@info.Label</span></td>
                        <td class="px-2 py-3 text-[12px] text-ink2">@o.CreatedAt.ToString("dd/MM HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
