@model AdminOrderListDto
@{
    ViewData["Title"] = "Đơn hàng";
    var statuses = new[] { OrderStatus.Pending, OrderStatus.Confirmed, OrderStatus.Processing, OrderStatus.Shipped, OrderStatus.Delivered, OrderStatus.Cancelled, OrderStatus.Refunded };
}

<div class="card border-0 shadow-sm">
    @* Tab lọc theo trạng thái *@
    <ul class="nav nav-tabs px-3 pt-2 flex-nowrap overflow-auto">
        <li class="nav-item">
            <a href="/admin/orders" class="nav-link @(Model.Filter == null ? "active" : "")">
                Tất cả <span class="badge text-bg-light ms-1">@Model.TotalCount</span>
            </a>
        </li>
        @foreach (var st in statuses)
        {
            var info = OrderStatusInfo.Describe(st);
            var count = Model.Counts.TryGetValue(st, out var c) ? c : 0;
            <li class="nav-item">
                <a href="/admin/orders?status=@st" class="nav-link text-nowrap @(Model.Filter == st ? "active" : "")">
                    @info.Label <span class="badge text-bg-light ms-1">@count</span>
                </a>
            </li>
        }
    </ul>

    @if (Model.Orders.Count == 0)
    {
        <p class="p-5 text-center text-body-secondary mb-0">Không có đơn hàng nào.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-uppercase text-body-secondary">
                        <th class="ps-4">Mã đơn</th>
                        <th>Nhận hàng</th>
                        <th>Sản phẩm</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Thanh toán</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Ngày</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        var info = OrderStatusInfo.Describe(o.Status);
                        <tr>
                            <td class="ps-4"><a href="/admin/orders/@o.Id" class="fw-bold text-accent font-monospace">#@o.Code</a></td>
                            <td class="small">@o.Recipient</td>
                            <td class="small text-body-secondary">@o.ItemsSummary</td>
                            <td class="text-end fw-bold">@o.Total.ToString("#,##0")₫</td>
                            <td class="text-center small text-body-secondary">@o.PaymentMethod</td>
                            <td class="text-center"><span class="badge rounded-pill @(info.IsCancelled ? "text-bg-danger" : "text-bg-light text-accent")">@info.Label</span></td>
                            <td class="small text-body-secondary">@o.CreatedAt.ToString("dd/MM HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
