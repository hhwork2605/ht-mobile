@model AdminOrderDetailDto
@{
    ViewData["Title"] = $"Đơn #{Model.Code}";
    var info = OrderStatusInfo.Describe(Model.Status);
}

<a href="/admin/orders" class="d-inline-block mb-3 small text-body-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Tất cả đơn hàng</a>

@if (TempData["StatusError"] is string err)
{
    <div class="alert alert-danger py-2 small">@err</div>
}

<div class="row g-4">
    @* Cột trái: thông tin + items *@
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <span class="font-monospace fs-5 fw-bold">#@Model.Code</span>
                        <span class="ms-3 small text-body-secondary">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <span class="badge rounded-pill @(info.IsCancelled ? "text-bg-danger" : "text-bg-light text-accent")">@info.Label</span>
                </div>
                <div class="row g-3 mt-1 small">
                    <div class="col-sm-6"><div class="text-body-secondary">Khách hàng</div><div class="fw-medium">@(Model.CustomerId is null ? "Khách vãng lai" : $"User #{Model.CustomerId}")</div></div>
                    <div class="col-sm-6"><div class="text-body-secondary">Thanh toán</div><div class="fw-medium">@Model.PaymentMethod</div></div>
                    <div class="col-12"><div class="text-body-secondary">Thông tin nhận hàng</div><div class="fw-medium">@(Model.ShipmentAddress ?? "—")</div></div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-3">Sản phẩm</h2>
                <ul class="list-group list-group-flush">
                    @foreach (var it in Model.Items)
                    {
                        <li class="list-group-item d-flex align-items-center justify-content-between px-0 small">
                            <div><span class="fw-semibold">@it.ProductName</span><span class="text-body-secondary"> @it.VariantText · SL @it.Quantity</span></div>
                            <span class="fw-semibold">@it.LineTotal.ToString("#,##0")₫</span>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-baseline justify-content-between border-top pt-3 mt-2">
                    <span class="fw-bold">Tổng tiền</span>
                    <span class="fs-4 fw-bold text-dark">@Model.Total.ToString("#,##0")₫</span>
                </div>
            </div>
        </div>
    </div>

    @* Cột phải: đổi trạng thái *@
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-3">Cập nhật trạng thái</h2>
                @if (Model.AllowedNext.Count == 0)
                {
                    <p class="small text-body-secondary mb-0">Đơn ở trạng thái cuối (@info.Label) — không thể đổi.</p>
                }
                else
                {
                    <form method="post" action="/admin/orders/@Model.Id/status">
                        @Html.AntiForgeryToken()
                        <select name="status" class="form-select mb-3">
                            @foreach (var next in Model.AllowedNext)
                            {
                                <option value="@next">@OrderStatusInfo.Describe(next).Label</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary w-100 fw-semibold">Cập nhật</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
