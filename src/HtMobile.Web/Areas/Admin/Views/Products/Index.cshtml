@model AdminProductListDto
@{
    ViewData["Title"] = "Sản phẩm";
}

@if (TempData["Flash"] is string flash)
{
    <div class="alert alert-success py-2 small">@flash</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
        <form method="get" action="/admin/products" class="d-flex align-items-center gap-2">
            <label class="small text-body-secondary mb-0">Danh mục</label>
            <select name="category" onchange="this.form.submit()" class="form-select form-select-sm w-auto">
                <option value="">Tất cả</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </form>
        <a href="/admin/products/create" class="btn btn-primary btn-sm fw-semibold">
            <i class="fa-solid fa-plus me-2"></i>Thêm sản phẩm
        </a>
    </div>

    @if (Model.Products.Count == 0)
    {
        <p class="p-5 text-center text-body-secondary mb-0">Chưa có sản phẩm nào.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-uppercase text-body-secondary">
                        <th class="ps-4">Sản phẩm</th>
                        <th>Danh mục</th>
                        <th class="text-center">Biến thể</th>
                        <th class="text-end">Giá bán</th>
                        <th class="text-center">Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr>
                            <td class="ps-4">
                                <a href="/admin/products/@p.Id/edit" class="fw-semibold text-dark">@p.Name</a>
                                <div class="small text-body-secondary">@p.Sku</div>
                            </td>
                            <td class="small text-body-secondary">@p.CategoryName</td>
                            <td class="text-center small text-body-secondary">@p.VariantCount</td>
                            <td class="text-end fw-bold">
                                @if (p.PriceFrom == p.PriceTo) { @($"{p.PriceFrom:#,##0}₫") }
                                else { @($"{p.PriceFrom:#,##0} – {p.PriceTo:#,##0}₫") }
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill @(p.IsActive ? "text-bg-light text-accent" : "text-bg-danger")">
                                    @(p.IsActive ? "Đang bán" : "Ẩn")
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <a href="/admin/products/@p.Id/edit" class="btn btn-sm btn-outline-primary">Sửa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
