@model ProductCreateVm
@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<a href="/admin/products" class="d-inline-block mb-3 small text-body-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Tất cả sản phẩm</a>

<form method="post" action="/admin/products/create" class="mx-auto" style="max-width:48rem;">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h6 fw-bold mb-3">Thông tin sản phẩm</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label small fw-semibold">Tên sản phẩm *</label>
                    <input asp-for="Name" class="form-control" placeholder="VD: iPhone 17 Pro Max" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Slug (bỏ trống = tự sinh từ tên)</label>
                    <input asp-for="Slug" class="form-control" placeholder="iphone-17-pro-max" />
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Danh mục *</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">— Chọn —</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Thương hiệu</label>
                    <input asp-for="Brand" class="form-control" placeholder="Apple" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Tagline</label>
                    <input asp-for="Tagline" class="form-control" placeholder="Titan. Mạnh mẽ." />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Mô tả</label>
                    <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h6 fw-bold mb-3">Biến thể đầu tiên</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">SKU *</label>
                    <input asp-for="Sku" class="form-control" placeholder="IP17PM-256-TIT" />
                    <span asp-validation-for="Sku" class="text-danger small"></span>
                </div>
                <div class="col-md-6"></div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Dung lượng</label>
                    <input asp-for="Storage" class="form-control" placeholder="256GB" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Màu</label>
                    <input asp-for="Color" class="form-control" placeholder="Titan tự nhiên" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Giá bán (₫) *</label>
                    <input asp-for="BasePrice" type="number" step="1" min="0" class="form-control" />
                    <span asp-validation-for="BasePrice" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Giá gạch (₫)</label>
                    <input asp-for="CompareAtPrice" type="number" step="1" min="0" class="form-control" />
                    <span asp-validation-for="CompareAtPrice" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Trạng thái</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<HtMobile.Domain.Enums.ProductStatus>()" class="form-select"></select>
                </div>
            </div>
        </div>
    </section>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary fw-semibold">Tạo sản phẩm</button>
        <a href="/admin/products" class="btn btn-outline-secondary fw-semibold">Huỷ</a>
    </div>
</form>
