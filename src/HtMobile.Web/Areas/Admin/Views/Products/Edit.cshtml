@model ProductEditVm
@{
    ViewData["Title"] = "Sửa sản phẩm";
    var input = "w-full rounded-[10px] border border-line px-3 py-2 text-[13.5px] text-ink focus:border-accent focus:outline-none";
    var label = "mb-1 block text-[12.5px] font-semibold text-ink2";
    var cell = "rounded-[8px] border border-line px-2 py-1.5 text-[13px] text-ink focus:border-accent focus:outline-none";
}

<div class="mb-3 flex items-center justify-between">
    <a href="/admin/products" class="text-[13px] text-ink2 hover:text-accent"><i class="fa-solid fa-arrow-left mr-1.5"></i>Tất cả sản phẩm</a>
    <a href="/@Model.Slug" target="_blank" class="text-[13px] text-accent hover:underline">Xem trên cửa hàng <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[11px]"></i></a>
</div>

@if (TempData["Flash"] is string flash)
{
    <div class="mb-4 rounded-card border border-green-200 bg-green-50 px-4 py-2.5 text-[13px] text-green-700">@flash</div>
}

@* ===== Form chính: field SP + giá/trạng thái biến thể ===== *@
<form method="post" action="/admin/products/@Model.Id/edit" class="max-w-3xl space-y-5">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-[13px] text-red-600"></div>

    <section class="rounded-card border border-line bg-white p-5">
        <h2 class="mb-4 text-[15px] font-bold text-ink">Thông tin sản phẩm</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
                <label class="@label">Tên sản phẩm *</label>
                <input asp-for="Name" class="@input" />
                <span asp-validation-for="Name" class="text-[12px] text-red-600"></span>
            </div>
            <div>
                <label class="@label">Slug</label>
                <input asp-for="Slug" class="@input" />
                <span asp-validation-for="Slug" class="text-[12px] text-red-600"></span>
            </div>
            <div>
                <label class="@label">Danh mục *</label>
                <select asp-for="CategoryId" class="@input">
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-[12px] text-red-600"></span>
            </div>
            <div>
                <label class="@label">Thương hiệu</label>
                <input asp-for="Brand" class="@input" />
            </div>
            <div>
                <label class="@label">Tagline</label>
                <input asp-for="Tagline" class="@input" />
            </div>
            <div class="sm:col-span-2">
                <label class="@label">Mô tả</label>
                <textarea asp-for="Description" rows="3" class="@input"></textarea>
            </div>
        </div>
    </section>

    <section class="rounded-card border border-line bg-white p-5">
        <h2 class="mb-1 text-[15px] font-bold text-ink">Biến thể</h2>
        <p class="mb-3 text-[12px] text-ink2">Sửa giá rồi bấm <b>Lưu thay đổi</b>. Nút Ẩn/Hiện lưu ngay (AJAX).</p>
        <table class="w-full border-collapse">
            <thead>
                <tr class="text-left text-[11px] font-bold uppercase tracking-wide text-ink2">
                    <th class="px-4 py-2">Biến thể</th>
                    <th class="px-2 py-2">Giá bán (₫)</th>
                    <th class="px-2 py-2">Giá gạch (₫)</th>
                    <th class="px-2 py-2">Trạng thái</th>
                    <th class="px-2 py-2"></th>
                </tr>
            </thead>
            <tbody id="variants">
                @for (var i = 0; i < Model.Variants.Count; i++)
                {
                    var v = Model.Variants[i];
                    var row = new AdminVariantRow
                    {
                        Id = v.Id, Sku = v.Sku, Storage = v.Storage, Color = v.Color,
                        BasePrice = v.BasePrice, CompareAtPrice = v.CompareAtPrice, Status = v.Status
                    };
                    <partial name="_VariantRow" model="@((row, i, Model.Id))" />
                }
            </tbody>
        </table>
    </section>

    <div class="flex gap-3">
        <button type="submit" class="rounded-[10px] bg-accent px-5 py-2.5 text-[13.5px] font-semibold text-white hover:bg-accent-press">Lưu thay đổi</button>
        <a href="/admin/products" class="rounded-[10px] border border-line px-5 py-2.5 text-[13.5px] font-semibold text-ink hover:bg-surface2">Quay lại</a>
    </div>
</form>

@* ===== Thêm biến thể (AJAX) — append vào bảng trên ===== *@
<section class="mt-5 max-w-3xl rounded-card border border-dashed border-line bg-white p-5">
    <h2 class="mb-3 text-[14px] font-bold text-ink">Thêm biến thể</h2>
    <form hx-post="/admin/products/@Model.Id/variants"
          hx-target="#variants"
          hx-swap="beforeend"
          hx-on::after-request="if(event.detail.successful) this.reset()"
          class="grid grid-cols-2 gap-3 sm:grid-cols-6">
        <input name="Sku" placeholder="SKU *" class="@cell sm:col-span-2" />
        <input name="Storage" placeholder="Dung lượng" class="@cell" />
        <input name="Color" placeholder="Màu" class="@cell" />
        <input name="BasePrice" type="number" step="1" min="0" placeholder="Giá *" class="@cell" />
        <input name="CompareAtPrice" type="number" step="1" min="0" placeholder="Giá gạch" class="@cell" />
        <input type="hidden" name="Status" value="0" />
        <div class="col-span-2 sm:col-span-6">
            <button type="submit" class="rounded-[10px] border border-accent px-4 py-2 text-[13px] font-semibold text-accent hover:bg-accent/10">
                <i class="fa-solid fa-plus mr-1.5"></i>Thêm biến thể
            </button>
        </div>
    </form>
</section>
