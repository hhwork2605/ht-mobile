@model ProductEditVm
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <a href="/admin/products" class="small text-body-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Tất cả sản phẩm</a>
    <a href="/@Model.Slug" target="_blank" class="small text-accent">Xem trên cửa hàng <i class="fa-solid fa-arrow-up-right-from-square ms-1 small"></i></a>
</div>

@if (TempData["Flash"] is string flash)
{
    <div class="alert alert-success py-2 small">@flash</div>
}

@* ===== Form chính: field SP + giá/trạng thái biến thể ===== *@
<form method="post" action="/admin/products/@Model.Id/edit" class="mx-auto" style="max-width:48rem;">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h6 fw-bold mb-3">Thông tin sản phẩm</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label small fw-semibold">Tên sản phẩm *</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Slug</label>
                    <input asp-for="Slug" class="form-control" />
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Danh mục *</label>
                    <select asp-for="CategoryId" class="form-select">
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Thương hiệu</label>
                    <input asp-for="Brand" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Tagline</label>
                    <input asp-for="Tagline" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Mô tả</label>
                    <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h6 fw-bold mb-1">Biến thể</h2>
            <p class="small text-body-secondary mb-3">Sửa giá rồi bấm <b>Lưu thay đổi</b>. Nút Ẩn/Hiện lưu ngay (AJAX).</p>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr class="small text-uppercase text-body-secondary">
                            <th>Biến thể</th>
                            <th>Giá bán (₫)</th>
                            <th>Giá gạch (₫)</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="variants">
                        @for (var i = 0; i < Model.Variants.Count; i++)
                        {
                            var v = Model.Variants[i];
                            var row = new AdminVariantRow
                            {
                                Id = v.Id, Sku = v.Sku, Storage = v.Storage, Color = v.Color,
                                BasePrice = v.BasePrice, CompareAtPrice = v.CompareAtPrice, Status = v.Status
                            };
                            <partial name="_VariantRow" model="@((row, i, Model.Id))" />
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary fw-semibold">Lưu thay đổi</button>
        <a href="/admin/products" class="btn btn-outline-secondary fw-semibold">Quay lại</a>
    </div>
</form>

@* ===== Thêm biến thể (AJAX) — append vào bảng trên ===== *@
<section class="card border-0 shadow-sm mt-4 mx-auto" style="max-width:48rem;">
    <div class="card-body">
        <h2 class="h6 fw-bold mb-3">Thêm biến thể</h2>
        <form hx-post="/admin/products/@Model.Id/variants"
              hx-target="#variants"
              hx-swap="beforeend"
              hx-on::after-request="if(event.detail.successful) this.reset()"
              class="row g-2 align-items-center">
            <div class="col-6 col-md-3"><input name="Sku" placeholder="SKU *" class="form-control form-control-sm" /></div>
            <div class="col-6 col-md-2"><input name="Storage" placeholder="Dung lượng" class="form-control form-control-sm" /></div>
            <div class="col-6 col-md-2"><input name="Color" placeholder="Màu" class="form-control form-control-sm" /></div>
            <div class="col-6 col-md-2"><input name="BasePrice" type="number" step="1" min="0" placeholder="Giá *" class="form-control form-control-sm" /></div>
            <div class="col-6 col-md-2"><input name="CompareAtPrice" type="number" step="1" min="0" placeholder="Giá gạch" class="form-control form-control-sm" /></div>
            <input type="hidden" name="Status" value="0" />
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-plus me-2"></i>Thêm biến thể</button>
            </div>
        </form>
    </div>
</section>
