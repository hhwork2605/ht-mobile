@using System.Globalization
@model (HtMobile.Application.Features.Catalog.Dtos.AdminVariantRow Row, int Index, long ProductId)
@{
    var v = Model.Row;
    var i = Model.Index;
    var active = v.Status == HtMobile.Domain.Enums.VariantStatus.Active;
    var cell = "rounded-[8px] border border-line px-2 py-1.5 text-[13px] text-ink focus:border-accent focus:outline-none";
}
<tr id="variant-@v.Id" class="border-t border-line">
    <input type="hidden" name="Variants[@i].Id" value="@v.Id" />
    <td class="px-4 py-2.5">
        <div class="text-[13px] font-semibold text-ink">@v.Sku</div>
        <div class="text-[11.5px] text-ink2">@(string.Join(" · ", new[] { v.Storage, v.Color }.Where(s => !string.IsNullOrWhiteSpace(s))))</div>
    </td>
    <td class="px-2 py-2.5">
        <input name="Variants[@i].BasePrice" type="number" step="1" min="0" value="@v.BasePrice.ToString("0", CultureInfo.InvariantCulture)" class="@cell w-28" />
    </td>
    <td class="px-2 py-2.5">
        <input name="Variants[@i].CompareAtPrice" type="number" step="1" min="0" value="@(v.CompareAtPrice?.ToString("0", CultureInfo.InvariantCulture))" class="@cell w-28" />
    </td>
    <td class="px-2 py-2.5">
        <input type="hidden" name="Variants[@i].Status" value="@((int)v.Status)" />
        <span class="rounded-full px-2.5 py-1 text-[11.5px] font-semibold @(active ? "bg-surface2 text-accent" : "bg-red-50 text-red-600")">
            @(active ? "Đang bán" : "Ẩn")
        </span>
    </td>
    <td class="px-2 py-2.5 text-right">
        <button type="button"
                hx-post="/admin/products/variants/@v.Id/toggle"
                hx-target="#variant-@v.Id"
                hx-swap="outerHTML"
                class="rounded-[8px] border border-line px-2.5 py-1 text-[12px] font-semibold text-ink hover:bg-surface2">
            @(active ? "Ẩn" : "Hiện")
        </button>
    </td>
</tr>
