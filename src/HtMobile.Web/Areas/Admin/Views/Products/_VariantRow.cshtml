@using System.Globalization
@model (HtMobile.Application.Features.Catalog.Dtos.AdminVariantRow Row, int Index, long ProductId)
@{
    var v = Model.Row;
    var i = Model.Index;
    var active = v.Status == HtMobile.Domain.Enums.ProductStatus.Active;
}
<tr id="variant-@v.Id">
    <input type="hidden" name="Variants[@i].Id" value="@v.Id" />
    <td>
        <div class="fw-semibold">@v.Sku</div>
        <div class="small text-body-secondary">@(string.Join(" · ", new[] { v.Storage, v.Color }.Where(s => !string.IsNullOrWhiteSpace(s))))</div>
    </td>
    <td>
        <input name="Variants[@i].BasePrice" type="number" step="1" min="0" value="@v.BasePrice.ToString("0", CultureInfo.InvariantCulture)" class="form-control form-control-sm" style="width:8rem;" />
    </td>
    <td>
        <input name="Variants[@i].CompareAtPrice" type="number" step="1" min="0" value="@(v.CompareAtPrice?.ToString("0", CultureInfo.InvariantCulture))" class="form-control form-control-sm" style="width:8rem;" />
    </td>
    <td>
        <input type="hidden" name="Variants[@i].Status" value="@((int)v.Status)" />
        <span class="badge rounded-pill @(active ? "text-bg-light text-accent" : "text-bg-danger")">@(active ? "Đang bán" : "Ẩn")</span>
    </td>
    <td class="text-end">
        <button type="button"
                hx-post="/admin/products/variants/@v.Id/toggle"
                hx-target="#variant-@v.Id"
                hx-swap="outerHTML"
                class="btn btn-sm btn-outline-secondary">
            @(active ? "Ẩn" : "Hiện")
        </button>
    </td>
</tr>
