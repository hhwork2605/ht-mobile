@model TradeInVm
@{
    ViewData["Title"] = "Thu cũ đổi mới";
    ViewData["MetaDescription"] = "Định giá thu cũ đổi mới sản phẩm Apple tại HtMobile — trợ giá lên đời hấp dẫn.";
    var input = "w-full rounded-xl border border-line px-3.5 py-3 text-[15px] text-ink outline-none focus:border-accent";

    var bases = string.Join(",", TradeInCatalog.Devices.Select(d => $"'{d.Key}':{(long)d.BaseValue}"));
    var factors = string.Join(",", TradeInCatalog.Conditions.Select(c => $"'{c.Key}':{c.Factor.ToString(System.Globalization.CultureInfo.InvariantCulture)}"));
    var xdata = "{ deviceKey:'', conditionKey:'', bases:{" + bases + "}, factors:{" + factors + "}, subsidy:" + (long)TradeInCatalog.Subsidy +
                ", money(n){return n.toLocaleString('vi-VN')+'₫'}," +
                " get tradeIn(){var b=this.bases[this.deviceKey],f=this.factors[this.conditionKey];return (b&&f)?Math.round(b*f):0}," +
                " get total(){return this.tradeIn>0?this.tradeIn+this.subsidy:0} }";
}

<div class="mx-auto max-w-[640px] px-4 sm:px-6 py-8">
    <h1 class="text-[28px] font-bold tracking-tight text-ink">Thu cũ đổi mới</h1>
    <p class="mt-1.5 text-[15px] text-ink2">Khai dòng máy cũ và tình trạng để nhận ước tính giá thu + trợ giá lên đời.</p>

    <form method="post" action="/thu-cu-doi-moi" class="mt-6 flex flex-col gap-5" x-data="@Html.Raw(xdata)">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-sm font-medium text-sale"></div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-ink">Dòng máy cũ</label>
            <select asp-for="DeviceKey" x-model="deviceKey" class="@input">
                <option value="">— Chọn dòng máy —</option>
                @foreach (var d in TradeInCatalog.Devices)
                {
                    <option value="@d.Key">@d.Name</option>
                }
            </select>
            <span asp-validation-for="DeviceKey" class="text-xs text-sale"></span>
        </div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-ink">Tình trạng máy</label>
            <div class="flex flex-col gap-2.5">
                @foreach (var c in TradeInCatalog.Conditions)
                {
                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line p-3 has-[:checked]:border-accent">
                        <input asp-for="ConditionKey" type="radio" value="@c.Key" x-model="conditionKey" class="h-4 w-4" />
                        <span class="text-sm text-ink">@c.Label</span>
                    </label>
                }
            </div>
            <span asp-validation-for="ConditionKey" class="text-xs text-sale"></span>
        </div>

        @* Ước tính live (Alpine) — server tính lại khi gửi *@
        <div x-show="total > 0" x-cloak x-transition class="rounded-card border border-line bg-surface2 p-4">
            <div class="flex justify-between text-sm text-ink2"><span>Giá thu ước tính</span><span class="font-semibold text-ink" x-text="money(tradeIn)"></span></div>
            <div class="mt-1 flex justify-between text-sm text-ink2"><span>Trợ giá lên đời</span><span class="font-semibold text-[color:var(--success)]" x-text="money(subsidy)"></span></div>
            <div class="mt-2 flex items-baseline justify-between border-t border-line pt-2"><span class="text-[15px] font-bold text-ink">Tổng nhận</span><span class="text-xl font-bold text-sale" x-text="money(total)"></span></div>
        </div>

        <button type="submit" class="rounded-full bg-accent px-6 py-3.5 font-semibold text-white transition hover:bg-accent-press">Gửi yêu cầu thu cũ</button>
        <p class="text-[12.5px] text-ink2">Giá trên là ước tính. Giá thu cuối cùng phụ thuộc thẩm định máy thực tế tại cửa hàng.</p>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
