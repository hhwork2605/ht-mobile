@{
    ViewData["Title"] = "Đặt hàng thành công";
    ViewData["MetaDescription"] = "Đặt hàng thành công tại HtMobile.";
    var code = ViewBag.Code as string;
}
@section Head { <meta name="robots" content="noindex, nofollow" /> }

<div class="mx-auto max-w-[480px] px-4 py-14 text-center">
    <div class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-green-50">
        <i class="fa-solid fa-circle-check text-[40px] text-green-600"></i>
    </div>
    <h1 class="text-[26px] font-bold text-ink">Đặt hàng thành công!</h1>
    <p class="mx-0 mb-1 mt-2 text-[15px] leading-relaxed text-ink2">Cảm ơn bạn đã mua sắm tại HtMobile. Nhân viên sẽ liên hệ xác nhận đơn trong ít phút.</p>
    @if (!string.IsNullOrEmpty(code))
    {
        <p class="mb-6 text-[15px] text-ink">Mã đơn hàng: <span class="font-bold text-accent">@code</span></p>
    }
    <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-xl bg-accent px-6 py-3 text-[15px] font-semibold text-white hover:bg-accent-press">Về trang chủ</a>
        <a href="/iphone" class="rounded-xl border border-line bg-white px-6 py-3 text-[15px] font-semibold text-ink hover:bg-surface2">Tiếp tục mua sắm</a>
    </div>
</div>
