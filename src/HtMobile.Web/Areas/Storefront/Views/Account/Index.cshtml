@model AccountVm
@{
    ViewData["Title"] = "Tài khoản";
    ViewData["MetaDescription"] = "Tài khoản & đơn hàng tại HtMobile.";
    var display = string.IsNullOrWhiteSpace(Model.FullName) ? Model.Email : Model.FullName;
    var initial = string.IsNullOrEmpty(display) ? "?" : display[..1].ToUpperInvariant();
}
@section Head { <meta name="robots" content="noindex, nofollow" /> }

<div class="mx-auto max-w-[920px] px-4 sm:px-6 py-8" x-data="{ tab: 'orders' }">

    @* Header *@
    <div class="mb-6 flex flex-wrap items-center gap-4">
        <div class="flex h-[60px] w-[60px] items-center justify-center rounded-full bg-surface2 text-2xl font-bold text-accent">@initial</div>
        <div class="min-w-[160px] flex-1">
            <h1 class="text-xl font-bold text-ink">@display</h1>
            <div class="text-[13.5px] text-ink2">@Model.Email</div>
        </div>
        <form method="post" action="/logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="rounded-[10px] border border-line bg-white px-4 py-2.5 text-[13.5px] font-semibold text-ink hover:bg-surface2">Đăng xuất</button>
        </form>
    </div>

    @* Tabs *@
    <div class="mb-6 flex gap-6 border-b border-line" role="tablist">
        <button type="button" role="tab" @@click="tab = 'orders'"
                :class="tab === 'orders' ? 'border-accent text-ink' : 'border-transparent text-ink2'"
                class="flex items-center gap-2 border-b-2 pb-3 text-sm font-semibold"><i class="iks ik-box"></i> Đơn hàng</button>
        <button type="button" role="tab" @@click="tab = 'info'"
                :class="tab === 'info' ? 'border-accent text-ink' : 'border-transparent text-ink2'"
                class="flex items-center gap-2 border-b-2 pb-3 text-sm font-semibold"><i class="ikr ik-circle-user"></i> Thông tin</button>
    </div>

    @* ===== Tab Đơn hàng ===== *@
    <div x-show="tab === 'orders'">
        @if (Model.Orders.Count == 0)
        {
            <div class="rounded-card py-14 text-center">
                <i class="iks ik-box-open text-[42px] text-ink2 opacity-40"></i>
                <p class="mx-0 my-4 text-[15px] text-ink2">Bạn chưa có đơn hàng nào.</p>
                <a href="/" class="inline-block rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-white hover:bg-accent-press">Mua sắm ngay</a>
            </div>
        }
        else
        {
            <div class="flex flex-col gap-4">
                @foreach (var o in Model.Orders)
                {
                    var st = OrderStatusInfo.Describe(o.Status);
                    <article class="rounded-2xl border border-line p-[18px]">
                        <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
                            <div>
                                <span class="text-sm font-bold text-ink">#@o.Code</span>
                                <span class="ml-2.5 text-[12.5px] text-ink2">@o.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </div>
                            <span class="rounded-full px-3 py-[5px] text-xs font-semibold @(st.IsCancelled ? "bg-sale/10 text-sale" : "bg-surface2 text-accent")">@st.Label</span>
                        </div>

                        @if (!st.IsCancelled)
                        {
                            <div class="mb-4 flex flex-wrap items-center gap-1">
                                @for (var i = 0; i < OrderStatusInfo.Steps.Length; i++)
                                {
                                    <div class="flex min-w-[110px] flex-1 items-center gap-1.5">
                                        <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full text-[11px] @(i <= st.StepIndex ? "bg-accent text-white" : "bg-surface2 text-ink2")">
                                            <i class="iks ik-check"></i>
                                        </span>
                                        <span class="whitespace-nowrap text-[11.5px] text-ink2">@OrderStatusInfo.Steps[i]</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="flex flex-col gap-2.5 border-t border-line pt-3.5">
                            @foreach (var it in o.Items)
                            {
                                <div class="flex items-center gap-3">
                                    <div class="flex h-[46px] w-[46px] flex-none items-center justify-center rounded-[10px] bg-surface2">
                                        <img src="@(string.IsNullOrEmpty(it.ThumbnailUrl) ? "/images/placeholder.svg" : it.ThumbnailUrl)"
                                             alt="@it.ProductName" width="46" height="46" loading="lazy" class="h-full w-full object-contain p-1" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        @if (!string.IsNullOrEmpty(it.VariantSlug))
                                        {
                                            <a href="/@it.VariantSlug" class="text-[13.5px] font-semibold text-ink hover:text-accent">@it.ProductName</a>
                                        }
                                        else
                                        {
                                            <div class="text-[13.5px] font-semibold text-ink">@it.ProductName</div>
                                        }
                                        <div class="text-[12px] text-ink2">@it.VariantText · SL @it.Quantity</div>
                                    </div>
                                    <span class="text-[13px] font-semibold text-ink">@it.LineTotal.ToString("#,##0")₫</span>
                                </div>
                            }
                        </div>

                        <div class="mt-3.5 flex items-baseline justify-between border-t border-line pt-3">
                            <span class="text-[13px] text-ink2">Tổng tiền</span>
                            <span class="text-[17px] font-bold text-sale">@o.Total.ToString("#,##0")₫</span>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    @* ===== Tab Thông tin ===== *@
    <div x-show="tab === 'info'" x-cloak class="max-w-[480px]">
        <div class="flex flex-col gap-3.5">
            <div>
                <div class="mb-1.5 text-[12.5px] text-ink2">Họ và tên</div>
                <div class="rounded-xl border border-line px-3.5 py-3 text-sm text-ink">@(string.IsNullOrWhiteSpace(Model.FullName) ? "—" : Model.FullName)</div>
            </div>
            <div>
                <div class="mb-1.5 text-[12.5px] text-ink2">Email</div>
                <div class="rounded-xl border border-line px-3.5 py-3 text-sm text-ink">@Model.Email</div>
            </div>
        </div>
    </div>
</div>
