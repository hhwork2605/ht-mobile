@model ForgotPasswordVm
@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["MetaDescription"] = "Đặt lại mật khẩu HtMobile.";
    var input = "w-full rounded-xl border border-line px-3.5 py-3 text-[15px] text-ink outline-none focus:border-accent";
    var sent = ViewBag.Sent == true;
}
@section Head { <meta name="robots" content="noindex, nofollow" /> }

<div class="mx-auto my-8 max-w-[380px] px-4 text-center">
    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-surface2">
        <i class="fa-solid fa-key text-2xl text-accent"></i>
    </div>
    <h1 class="text-2xl font-bold text-ink">Quên mật khẩu</h1>

    @if (sent)
    {
        <p class="mt-3 rounded-xl bg-surface2 p-4 text-sm text-ink2">
            Nếu email tồn tại trong hệ thống, chúng tôi đã gửi liên kết đặt lại mật khẩu. Vui lòng kiểm tra hộp thư.
        </p>
        <a href="/login" class="mt-4 inline-block text-sm text-accent hover:underline">← Về đăng nhập</a>
    }
    else
    {
        <p class="mb-6 mt-1.5 text-sm text-ink2">Nhập email tài khoản, chúng tôi sẽ gửi liên kết đặt lại mật khẩu.</p>
        <form method="post" action="/forgot-password" class="flex flex-col gap-3 text-left">
            @Html.AntiForgeryToken()
            <div>
                <input asp-for="Email" class="@input" placeholder="Email" autocomplete="username" />
                <span asp-validation-for="Email" class="text-xs text-sale"></span>
            </div>
            <button type="submit" class="mt-1 rounded-xl bg-accent py-3.5 font-bold text-white transition hover:bg-accent-press">Gửi liên kết</button>
        </form>
        <a href="/login" class="mt-4 inline-block text-sm text-accent hover:underline">← Về đăng nhập</a>
    }
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
