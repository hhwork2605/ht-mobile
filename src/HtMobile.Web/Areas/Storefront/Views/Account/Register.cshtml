@model RegisterVm
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["MetaDescription"] = "Tạo tài khoản HtMobile.";
    var input = "w-full rounded-xl border border-line px-3.5 py-3 text-[15px] text-ink outline-none focus:border-accent";
}
@section Head { <meta name="robots" content="noindex, nofollow" /> }

<div class="mx-auto my-8 max-w-[380px] px-4 text-center">
    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-surface2">
        <i class="iks ik-circle-user text-2xl text-accent"></i>
    </div>
    <h1 class="text-2xl font-bold text-ink">Tạo tài khoản</h1>
    <p class="mb-6 mt-1.5 text-sm text-ink2">Đăng ký để mua sắm nhanh hơn và nhận ưu đãi thành viên.</p>

    <form method="post" action="/register" class="flex flex-col gap-3 text-left">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-sm font-medium text-sale"></div>
        <div>
            <input asp-for="FullName" class="@input" placeholder="Họ và tên" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-xs text-sale"></span>
        </div>
        <div>
            <input asp-for="Email" class="@input" placeholder="Email" autocomplete="username" />
            <span asp-validation-for="Email" class="text-xs text-sale"></span>
        </div>
        <div>
            <input asp-for="Password" class="@input" placeholder="Mật khẩu" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-xs text-sale"></span>
        </div>
        <div>
            <input asp-for="ConfirmPassword" class="@input" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-sale"></span>
        </div>
        <button type="submit" class="mt-1 rounded-xl bg-accent py-3.5 font-bold text-white transition hover:bg-accent-press">Đăng ký</button>
    </form>

    <p class="mt-4 text-sm text-ink2">Đã có tài khoản? <a href="/login" class="text-accent hover:underline">Đăng nhập</a></p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
