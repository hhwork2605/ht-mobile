@model ResetPasswordVm
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["MetaDescription"] = "Đặt lại mật khẩu HtMobile.";
    var input = "w-full rounded-xl border border-line px-3.5 py-3 text-[15px] text-ink outline-none focus:border-accent";
    var done = ViewBag.Done == true;
}
@section Head { <meta name="robots" content="noindex, nofollow" /> }

<div class="mx-auto my-8 max-w-[380px] px-4 text-center">
    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-surface2">
        <i class="iks ik-lock text-2xl text-accent"></i>
    </div>
    <h1 class="text-2xl font-bold text-ink">Đặt lại mật khẩu</h1>

    @if (done)
    {
        <p class="mt-3 rounded-xl bg-surface2 p-4 text-sm text-ink2">Mật khẩu đã được đặt lại (nếu liên kết hợp lệ).</p>
        <a href="/login" class="mt-4 inline-block rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-white hover:bg-accent-press">Đăng nhập</a>
    }
    else
    {
        <p class="mb-6 mt-1.5 text-sm text-ink2">Nhập mật khẩu mới cho tài khoản của bạn.</p>
        <form method="post" action="/reset-password" class="flex flex-col gap-3 text-left">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="text-sm font-medium text-sale"></div>
            <div>
                <input asp-for="Password" class="@input" placeholder="Mật khẩu mới" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-xs text-sale"></span>
            </div>
            <div>
                <input asp-for="ConfirmPassword" class="@input" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-sale"></span>
            </div>
            <button type="submit" class="mt-1 rounded-xl bg-accent py-3.5 font-bold text-white transition hover:bg-accent-press">Đặt lại mật khẩu</button>
        </form>
    }
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
