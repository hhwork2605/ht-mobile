@model HtMobile.Application.Features.Cart.Dtos.CartDto
@{
    ViewData["Title"] = "Giỏ hàng";
    ViewData["MetaDescription"] = "Giỏ hàng của bạn tại HtMobile.";
}

@section Head {
    @* Giỏ hàng riêng tư theo phiên → không index. *@
    <meta name="robots" content="noindex, nofollow" />
}

<div class="mx-auto max-w-[1180px] px-4 sm:px-6 py-6">
    <h1 class="mb-5 text-[28px] font-bold tracking-tight text-ink">Giỏ hàng</h1>
    <partial name="_CartBody" model="Model" />
</div>
