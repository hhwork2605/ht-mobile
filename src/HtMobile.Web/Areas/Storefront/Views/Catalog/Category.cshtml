@model CategoryPageDto
@{
    ViewData["Title"] = Model.Name;
    ViewData["MetaDescription"] = string.IsNullOrWhiteSpace(Model.SeoContent)
        ? $"Mua {Model.Name} chính hãng tại HtMobile — giá tốt, trả góp 0%, thu cũ đổi mới, giao nhanh toàn quốc."
        : System.Text.RegularExpressions.Regex.Replace(Model.SeoContent, "<.*?>", " ").Trim();

    var req = Context.Request;
    var baseUrl = $"{req.Scheme}://{req.Host}";
    var canonical = $"{baseUrl}/{Model.Slug}";
}

@section Head {
    <script type="application/ld+json">@Html.Raw(JsonLd.Breadcrumb(new[]
    {
        ("Trang chủ", baseUrl),
        (Model.Name, canonical)
    }))</script>
    @if (Model.Products.Count > 0)
    {
        <script type="application/ld+json">@Html.Raw(JsonLd.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "ItemList",
            ["name"] = Model.Name,
            ["numberOfItems"] = Model.Products.Count,
            ["itemListElement"] = Model.Products.Select((p, idx) => new Dictionary<string, object?>
            {
                ["@type"] = "ListItem",
                ["position"] = idx + 1,
                ["url"] = $"{baseUrl}/{p.VariantSlug}",
                ["name"] = p.Name
            }).ToList()
        }))</script>
    }
}

<div class="mx-auto max-w-[1180px] px-4 sm:px-6 py-[22px] pb-[50px]"
     x-data="{ range: 'all', sort: 'popular',
               inRange(p){ if(this.range==='all')return true; const [lo,hi]=this.range.split('-').map(Number); return p>=lo && p<hi; },
               applySort(){ const g=$refs.grid; const items=[...g.children]; const v=this.sort;
                 items.sort((a,b)=>{ const pa=+a.dataset.price, pb=+b.dataset.price, na=+a.dataset.idx, nb=+b.dataset.idx;
                   if(v==='price-asc')return pa-pb; if(v==='price-desc')return pb-pa; if(v==='newest')return nb-na; return na-nb; });
                 items.forEach(el=>g.appendChild(el)); } }">

    <nav aria-label="Breadcrumb" class="mb-3.5 flex items-center gap-2 text-[13px] text-ink2">
        <a href="/" class="hover:text-accent">Trang chủ</a><span>/</span><span class="text-ink" aria-current="page">@Model.Name</span>
    </nav>

    <h1 class="text-[30px] font-bold tracking-[-.5px] text-ink">@Model.Name</h1>
    <p class="mt-1 mb-5 text-[14px] text-ink2">@Model.Products.Count sản phẩm</p>

    <div class="flex items-start gap-7">
        @* --- Sidebar lọc (desktop) --- *@
        <aside class="hidden w-[222px] flex-none md:block">
            <div class="mb-2.5 text-[12px] font-bold tracking-[.4px] text-ink">KHOẢNG GIÁ</div>
            <div class="mb-6 flex flex-col gap-2">
                @{
                    var ranges = new (string Id, string Label)[]
                    {
                        ("all", "Tất cả mức giá"),
                        ("0-10000000", "Dưới 10 triệu"),
                        ("10000000-20000000", "10 – 20 triệu"),
                        ("20000000-30000000", "20 – 30 triệu"),
                        ("30000000-999000000000", "Trên 30 triệu"),
                    };
                }
                @foreach (var r in ranges)
                {
                    <button type="button" @@click="range='@r.Id'"
                            :class="range==='@r.Id' ? 'border-accent bg-accent/5 text-accent' : 'border-line text-ink hover:border-accent'"
                            class="rounded-xl border px-3.5 py-2 text-left text-[13.5px] font-medium transition">@r.Label</button>
                }
            </div>
        </aside>

        <div class="min-w-0 flex-1">
            @* --- Sort bar --- *@
            <div class="mb-[18px] flex flex-wrap items-center gap-2">
                <span class="mr-0.5 text-[13px] text-ink2">Sắp xếp:</span>
                @{
                    var sorts = new (string Id, string Label)[]
                    {
                        ("popular", "Phổ biến"), ("price-asc", "Giá thấp → cao"),
                        ("price-desc", "Giá cao → thấp"), ("newest", "Mới nhất"),
                    };
                }
                @foreach (var s in sorts)
                {
                    <button type="button" @@click="sort='@s.Id'; applySort()"
                            :class="sort==='@s.Id' ? 'bg-accent text-white' : 'bg-surface2 text-ink hover:bg-line'"
                            class="rounded-full px-3.5 py-1.5 text-[13px] font-semibold transition">@s.Label</button>
                }
            </div>

            @if (Model.Products.Count == 0)
            {
                <p class="rounded-card bg-surface2 p-8 text-center text-ink2">Danh mục này chưa có sản phẩm.</p>
            }
            else
            {
                <div x-ref="grid" class="grid gap-4 [grid-template-columns:repeat(2,1fr)] lg:[grid-template-columns:repeat(3,1fr)]">
                    @{ var idx = 0; }
                    @foreach (var p in Model.Products)
                    {
                        <div data-price="@p.FinalPrice.ToString("0")" data-idx="@idx" x-show="inRange(@p.FinalPrice.ToString("0"))" x-transition.opacity>
                            <vc:product-card product="p"></vc:product-card>
                        </div>
                        idx++;
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SeoContent))
            {
                <section class="prose mt-10 max-w-none rounded-card bg-surface2 p-6 text-sm text-ink2">
                    @Html.Raw(Model.SeoContent)
                </section>
            }
        </div>
    </div>
</div>
